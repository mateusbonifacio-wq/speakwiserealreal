# Supabase (obrigatório)
# Em Supabase: Settings → API → copiar Project URL, anon public, service_role
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Acesso por código (obrigatório) – mesma palavra-passe para as 5 contas
ACCESS_CODE_PASSWORD=escolhe_uma_palavra_passe_forte

# ElevenLabs – transcrição de áudio
# https://elevenlabs.io → API key
ELEVENLABS_API_KEY=sk_...

# Google AI (Gemini) – análise do pitch
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=...

# Copiar para .env.local e preencher com os teus valores.
# No Vercel: Settings → Environment Variables (as mesmas variáveis).
